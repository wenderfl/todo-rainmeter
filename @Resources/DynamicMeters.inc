[MeterAddTasks]
Meter=String
Text=#fa-plus-sq#
FontFace=FontAwesome
FontSize=34
FontColor=255,255,255,255,10
SolidColor=0,0,0,1
AntiAlias=1
X=727
Y=36
ToolTipText="Adicionar Tarefa"
MouseOverAction=[!SetOption MeterAddTasks FontColor "#HoverColor#"][!UpdateMeter MeterAddTasks][!Redraw]
MouseLeaveAction=[!SetOption MeterAddTasks FontColor "255,255,255,255,10"][!UpdateMeter MeterAddTasks][!Redraw]
LeftMouseUpAction=[!CommandMeasure MeasureInput "ExecuteBatch 1-2"]
[MeterRefreshTasks]
Meter=String
Text=#fa-refresh#
FontFace=FontAwesome
FontSize=34
FontColor=255,255,255,255,10
SolidColor=0,0,0,1
AntiAlias=1
X=r
Y=34R
ToolTipText="Recarregar"
MouseOverAction=[!SetOption MeterRefreshTasks FontColor "#HoverColor#"][!UpdateMeter MeterRefreshTasks][!Redraw]
MouseLeaveAction=[!SetOption MeterRefreshTasks FontColor "255,255,255,255,10"][!UpdateMeter MeterRefreshTasks][!Redraw]
LeftMouseUpAction=[!RefreshGroup ToDoList]
[MeterUndoTasks]
Meter=String
Text=#fa-trash#
FontFace=FontAwesome
FontSize=34
FontColor=255,255,255,255,10
SolidColor=0,0,0,1
AntiAlias=1
X=r
Y=34R
ToolTipText="Limpar Concluídas"
MouseOverAction=[!SetOption MeterUndoTasks FontColor "#HoverColor#"][!UpdateMeter MeterUndoTasks][!Redraw]
MouseLeaveAction=[!SetOption MeterUndoTasks FontColor "255,255,255,255,10"][!UpdateMeter MeterUndoTasks][!Redraw]
LeftMouseUpAction=[!CommandMeasure "MeasureDynamicTasks" "ResetAll()"][!RefreshGroup ToDoList]
[MeterSettings]
Meter=String
Text=#fa-cog#
FontFace=FontAwesome
FontSize=34
FontColor=255,255,255,255,10
SolidColor=0,0,0,1
AntiAlias=1
X=r
Y=34R
ToolTipText="Configurações"
MouseOverAction=[!SetOption MeterSettings FontColor "#HoverColor#"][!UpdateMeter MeterSettings][!Redraw]
MouseLeaveAction=[!SetOption MeterSettings FontColor "255,255,255,255,200"][!UpdateMeter MeterSettings][!Redraw]
LeftMouseUpAction=[!ToggleConfig "rainmeter-todo-list\config" "config.ini"]
[MeterTaskIcon1]
Meter=String
Text=#fa-sq#
FontColor=255,255,255,255,180
FontFace=FontAwesome
FontSize=25
SolidColor=0,0,0,1
AntiAlias=1
X=30
Y=54
ToolTipText="Concluir"
LeftMouseUpAction=[!CommandMeasure "MeasureDynamicTasks" "CheckLine(1)"][!Delay 30][!RefreshGroup ToDoList]
[MeterTaskText1]
Meter=String
Text=PESCAR
FontFace=Segoe UI
FontSize=(30 * [MeasureScale])
StringStyle=Bold
FontColor=255,255,255,255
SolidColor=0,0,0,1
AntiAlias=1
DynamicVariables=1
ClipString=1
X=73
Y=(48 + [MeasureOsc])
H=55
W=585
LeftMouseUpAction=[!CommandMeasure "MeasureDynamicTasks" "CheckLine(1)"][!Delay 30][!RefreshGroup ToDoList]
[MeterDeleteTask1]
Meter=String
Text=#fa-trash#
FontFace=FontAwesome
FontSize=25
FontColor=220,70,70,140
SolidColor=0,0,0,1
AntiAlias=1
X=662
Y=54
ToolTipText="Excluir tarefa"
MouseOverAction=[!SetOption MeterDeleteTask1 FontColor "255,80,80,255"][!UpdateMeter MeterDeleteTask1][!Redraw]
MouseLeaveAction=[!SetOption MeterDeleteTask1 FontColor "220,70,70,140"][!UpdateMeter MeterDeleteTask1][!Redraw]
LeftMouseUpAction=[!CommandMeasure "MeasureDynamicTasks" "DeleteLine(1)"][!Delay 30][!RefreshGroup ToDoList]
[MeterInputAnchor]
Meter=String
Text=
X=0
Y=121
DynamicVariables=1
