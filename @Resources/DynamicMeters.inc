[MeterAddTasks]
Meter=String
Text=#fa-plus-sq#
FontFace=FontAwesome
FontSize=13
FontColor=255,255,255,180
SolidColor=0,0,0,1
AntiAlias=1
X=270
Y=14
ToolTipText="Add Task"
MouseOverAction=[!SetOption MeterAddTasks FontColor "#HoverColor#"][!UpdateMeter MeterAddTasks][!Redraw]
MouseLeaveAction=[!SetOption MeterAddTasks FontColor "255,255,255,180"][!UpdateMeter MeterAddTasks][!Redraw]
LeftMouseUpAction=[!CommandMeasure MeasureInput "ExecuteBatch 1-2"]
[MeterRefreshTasks]
Meter=String
Text=#fa-refresh#
FontFace=FontAwesome
FontSize=13
FontColor=255,255,255,180
SolidColor=0,0,0,1
AntiAlias=1
X=r
Y=13R
ToolTipText="Refresh"
MouseOverAction=[!SetOption MeterRefreshTasks FontColor "#HoverColor#"][!UpdateMeter MeterRefreshTasks][!Redraw]
MouseLeaveAction=[!SetOption MeterRefreshTasks FontColor "255,255,255,180"][!UpdateMeter MeterRefreshTasks][!Redraw]
LeftMouseUpAction=[!RefreshGroup ToDoList]
[MeterUndoTasks]
Meter=String
Text=#fa-trash#
FontFace=FontAwesome
FontSize=13
FontColor=255,255,255,180
SolidColor=0,0,0,1
AntiAlias=1
X=r
Y=13R
ToolTipText="Clear Completed"
MouseOverAction=[!SetOption MeterUndoTasks FontColor "#HoverColor#"][!UpdateMeter MeterUndoTasks][!Redraw]
MouseLeaveAction=[!SetOption MeterUndoTasks FontColor "255,255,255,180"][!UpdateMeter MeterUndoTasks][!Redraw]
LeftMouseUpAction=[!CommandMeasure "MeasureDynamicTasks" "ResetAll()"][!RefreshGroup ToDoList]
[MeterSettings]
Meter=String
Text=#fa-cog#
FontFace=FontAwesome
FontSize=13
FontColor=255,255,255,180
SolidColor=0,0,0,1
AntiAlias=1
X=r
Y=13R
ToolTipText="Settings"
MouseOverAction=[!SetOption MeterSettings FontColor "#HoverColor#"][!UpdateMeter MeterSettings][!Redraw]
MouseLeaveAction=[!SetOption MeterSettings FontColor "255,255,255,180"][!UpdateMeter MeterSettings][!Redraw]
LeftMouseUpAction=[!ToggleConfig "rainmeter-todo-list\config" "config.ini"]
[MeterTaskIcon1]
Meter=String
Text=#fa-sq#
FontColor=255,255,255,180
FontFace=FontAwesome
FontSize=(10 * [MeasureScale])
SolidColor=0,0,0,1
AntiAlias=1
DynamicVariables=1
X=12
Y=21
ToolTipText="Complete Task"
LeftMouseUpAction=[!CommandMeasure "MeasureDynamicTasks" "CheckLine(1)"][!Delay 30][!RefreshGroup ToDoList]
[MeterTaskText1]
Meter=String
Text=Exemple
FontFace=Segoe UI
FontSize=(12 * [MeasureScale])
StringStyle=Bold
FontColor=255,255,255,255
SolidColor=0,0,0,1
AntiAlias=1
DynamicVariables=1
ClipString=1
X=29
Y=(19 + [MeasureOsc])
H=22
W=215
LeftMouseUpAction=[!CommandMeasure "MeasureDynamicTasks" "CheckLine(1)"][!Delay 30][!RefreshGroup ToDoList]
[MeterDeleteTask1]
Meter=String
Text=#fa-trash#
FontFace=FontAwesome
FontSize=(10 * [MeasureScale])
FontColor=255,255,255,180
SolidColor=0,0,0,1
AntiAlias=1
DynamicVariables=1
X=248
Y=21
ToolTipText="Delete Task"
MouseOverAction=[!SetOption MeterDeleteTask1 FontColor "255,80,80,255"][!UpdateMeter MeterDeleteTask1][!Redraw]
MouseLeaveAction=[!SetOption MeterDeleteTask1 FontColor "255,255,255,180"][!UpdateMeter MeterDeleteTask1][!Redraw]
LeftMouseUpAction=[!CommandMeasure "MeasureDynamicTasks" "DeleteLine(1)"][!Delay 30][!RefreshGroup ToDoList]
[MeterInputAnchor]
Meter=String
Text=
X=0
Y=48
DynamicVariables=1
@Include=#@#FontAwesome.inc